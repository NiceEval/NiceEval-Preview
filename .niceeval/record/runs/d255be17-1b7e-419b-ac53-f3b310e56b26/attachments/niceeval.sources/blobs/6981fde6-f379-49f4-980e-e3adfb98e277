import { defineEval } from "niceeval";
import { eventMatch, includes } from "niceeval/expect";

export default defineEval({
  description: "A deterministic passed Verdict",
  tags: ["state", "pass"],
  async test(t) {
    const turn = await t.send("preview/state/pass");
    turn.succeeded().label("Pass turn completed");
    t.check(turn.message, includes("preview/state/pass")).label("Pass marker");
    turn.notCalledTool("forbidden_state_tool").label("Turn-level tool absence");
    turn.usedNoTools().label("Turn-level no-tools assertion");
    turn.noFailedActions().label("Turn-level failure absence");
    turn.notEvent(eventMatch("message", { text: includes("MISSING_STATE_EVENT") }))
      .label("Turn-level event absence");
    t.notCalledTool("forbidden_state_tool").label("Attempt-level tool absence");
    t.usedNoTools().label("Attempt-level no-tools assertion");
    t.noFailedActions().label("Attempt-level failure absence");
    t.notEvent(eventMatch("message", { text: includes("MISSING_STATE_EVENT") }))
      .label("Attempt-level event absence");
  },
});
