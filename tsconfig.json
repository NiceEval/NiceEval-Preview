{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "agents/**/*.ts",
    "evals/**/*.ts",
    "experiments/**/*.ts",
    "sandboxes/**/*.ts",
    "niceeval.config.ts"
  ]
}
